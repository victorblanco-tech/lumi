{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumi.local/contracts/protocol/v1/envelope.schema.json",
  "title": "Lumi protocol v1 envelope",
  "type": "object",
  "required": [
    "protocolVersion",
    "messageType",
    "messageId",
    "sequence",
    "correlationId",
    "sentAt",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "messageType": {
      "enum": ["command", "snapshot", "event", "error"]
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
